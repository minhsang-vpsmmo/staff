{
  "name": "vpsmmo-monitoring",
  "version": "1.0.0",
  "description": "VPSMMO Monitoring — Commercial uptime monitoring SaaS with prepaid wallet",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "LOG_LEVEL=debug node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "check:invariants": "bash scripts/check-invariants.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:owners": "bash scripts/check-owner-leaks.sh",
    "audit:strict": "bash scripts/npm-audit-strict.sh"
  },
  "keywords": ["monitoring", "uptime", "vpsmmo"],
  "author": "VPSMMO.VN",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nanoid": "^3.3.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "p-limit": "^3.1.0",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "undici": "^6.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
