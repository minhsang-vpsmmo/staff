# ============================================================
# .env — VPSMMO Monitoring Environment Variables
# ============================================================
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

NODE_ENV=production
PORT=3000
APP_URL=https://monitoring.vpsmmo.vn

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vpsmmo_monitoring
DB_PASSWORD=__REQUIRED__
DB_NAME=vpsmmo_monitoring

# ── Auth ──
JWT_ACCESS_SECRET=__REQUIRED__
JWT_REFRESH_SECRET=__REQUIRED__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Pay2S ──
PAY2S_WEBHOOK_SECRET=__REQUIRED__
PAY2S_API_TOKEN=__REQUIRED__
PAY2S_BANK_ACCOUNTS=12805521,737478888
PAY2S_ALLOWED_IPS=

# ── Email (Gmail SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=__REQUIRED__
SMTP_APP_PASSWORD=__REQUIRED__
SMTP_FROM=no-reply@vpsmmo.vn

# ── Telegram ──
TELEGRAM_BOT_TOKEN=__REQUIRED__
TELEGRAM_ADMIN_CHAT_ID=__REQUIRED__

# ── Ops ──
LOG_LEVEL=info
ADMIN_ALERT_TELEGRAM=
